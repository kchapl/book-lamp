{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "book_lamp/static",
        "rootDir": "src",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/react/*"]
        }
    },
    "include": [
        "src/ts/**/*.ts",
        "src/ts/**/*.tsx",
        "src/react/**/*.ts",
        "src/react/**/*.tsx"
    ]
}