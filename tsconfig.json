{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/react/*"]
        }
    },
    "include": [
        "src/react/**/*.ts",
        "src/react/**/*.tsx"
    ],
    "exclude": [
        "src/**/__tests__/*",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
    ]
}