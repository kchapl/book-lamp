{
  "name": "book-lamp-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:fast": "lhci autorun --collect.numberOfRuns=1",
    "lighthouse:report": "uv run python scripts/lhci_actionable_report.py",
    "lighthouse:fast:report": "npm run lighthouse:fast; npm run lighthouse:report",
    "build:react": "vite build",
    "dev": "vite"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "html5-qrcode": "2.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.1"
  }
}
